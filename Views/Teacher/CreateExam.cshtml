@model CBAssessment.Models.Exam
@{
    ViewData["Title"] = "Create Exam";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var sections = (List<CBAssessment.Models.Section>)ViewBag.Sections;
}

<div class="page-header">
    <h1>Create New Exam</h1>
    <a asp-action="Dashboard" class="btn btn-secondary">Back</a>
</div>

<div class="form-container">
    <form asp-action="CreateExam" method="post">
        <div class="form-group">
            <label>Exam Title</label>
            <input type="text" name="Title" required placeholder="e.g., Math Mid-Term Exam" />
        </div>
        <div class="form-group">
            <label>Description</label>
            <textarea name="Description" rows="3" placeholder="Brief description of the exam"></textarea>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label>Subject</label>
                <select name="SubjectId" required>
                    <option value="">-- Select Subject --</option>
                    @foreach (var subject in ViewBag.Subjects)
                    {
                        <option value="@subject.Id">@subject.Name (@subject.Code)</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label>Time Limit (minutes)</label>
                <input type="number" name="TimeLimitMinutes" value="60" min="5" max="180" />
            </div>
        </div>
        <div class="form-group">
            <label>Assign to Sections</label>
            @if (sections.Any())
            {
                <div class="section-checkbox-grid">
                    <label class="checkbox-label checkbox-all">
                        <input type="checkbox" id="selectAll" onchange="toggleAll()" />
                        <strong>Select All</strong>
                    </label>
                </div>
                <div class="section-checkbox-grid">
                    @foreach (var sec in sections)
                    {
                        <label class="checkbox-label">
                            <input type="checkbox" name="targetSections" value="@sec.Name" class="section-cb" />
                            @sec.Name
                        </label>
                    }
                </div>
            }
            else
            {
                <div class="empty-state-inline">
                    <p>No sections yet.</p>
                    <a asp-action="ManageSections" class="btn btn-sm">Create Sections First</a>
                </div>
            }
            <small class="text-muted">Leave all unchecked to make the exam available to all sections.</small>
        </div>
        <button type="submit" class="btn btn-primary btn-block">Create Exam</button>
    </form>
</div>

<script>
    function toggleAll() {
        var checked = document.getElementById('selectAll').checked;
        document.querySelectorAll('.section-cb').forEach(function(cb) {
            cb.checked = checked;
        });
    }
</script>
