@model CBAssessment.Models.Question
@{
    ViewData["Title"] = "Edit Question";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var isMC = Model.Type == CBAssessment.Models.QuestionType.MultipleChoice;
    var isTF = Model.Type == CBAssessment.Models.QuestionType.TrueFalse;
    var displayStyle = isTF ? "none" : "block";
}

<div class="page-header">
    <h1>Edit Question</h1>
    <a asp-action="ViewQuestions" asp-route-examId="@Model.ExamId" class="btn btn-secondary">Back</a>
</div>

<div class="form-container">
    <form asp-action="EditQuestion" method="post">
        <input type="hidden" name="id" value="@Model.Id" />

        <div class="form-group">
            <label>Question Text</label>
            <textarea name="questionText" rows="2" required>@Model.Text</textarea>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label>Question Type</label>
                <select name="type" id="questionType" onchange="toggleOptions()">
                    @if (isMC)
                    {
                        <option value="MultipleChoice" selected="selected">Multiple Choice</option>
                        <option value="TrueFalse">True / False</option>
                    }
                    else
                    {
                        <option value="MultipleChoice">Multiple Choice</option>
                        <option value="TrueFalse" selected="selected">True / False</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label>Points</label>
                <input type="number" name="points" value="@Model.Points" min="1" max="10" />
            </div>
        </div>

        <div class="options-container" id="extraOptions" style="display: @displayStyle">
            <div class="form-group">
                <label>Option A</label>
                <input type="text" name="optionA" required id="optA" value="@Model.OptionA" />
            </div>
            <div class="form-group">
                <label>Option B</label>
                <input type="text" name="optionB" required id="optB" value="@Model.OptionB" />
            </div>
            <div>
                <div class="form-group">
                    <label>Option C</label>
                    <input type="text" name="optionC" id="optC" value="@Model.OptionC" />
                </div>
                <div class="form-group">
                    <label>Option D</label>
                    <input type="text" name="optionD" id="optD" value="@Model.OptionD" />
                </div>
            </div>
        </div>

        <div class="form-group">
            <label>Correct Answer</label>
            <select name="correctAnswer" id="correctAnswer">
                @if (isTF)
                {
                    @if (Model.CorrectAnswer == "A")
                    {
                        <option value="A" selected="selected">True</option>
                        <option value="B">False</option>
                    }
                    else
                    {
                        <option value="A">True</option>
                        <option value="B" selected="selected">False</option>
                    }
                }
                else
                {
                    @if (Model.CorrectAnswer == "A")
                    {
                        <option value="A" selected="selected">A</option>
                    }
                    else
                    {
                        <option value="A">A</option>
                    }
                    @if (Model.CorrectAnswer == "B")
                    {
                        <option value="B" selected="selected">B</option>
                    }
                    else
                    {
                        <option value="B">B</option>
                    }
                    @if (Model.CorrectAnswer == "C")
                    {
                        <option value="C" selected="selected">C</option>
                    }
                    else
                    {
                        <option value="C">C</option>
                    }
                    @if (Model.CorrectAnswer == "D")
                    {
                        <option value="D" selected="selected">D</option>
                    }
                    else
                    {
                        <option value="D">D</option>
                    }
                }
            </select>
        </div>

        <button type="submit" class="btn btn-primary btn-block">Save Changes</button>
    </form>
</div>

<script>
    function toggleOptions() {
        var type = document.getElementById('questionType').value;
        var extra = document.getElementById('extraOptions');
        var correctSelect = document.getElementById('correctAnswer');
        if (type === 'TrueFalse') {
            extra.style.display = 'none';
            correctSelect.innerHTML = '<option value="A">True</option><option value="B">False</option>';
        } else {
            extra.style.display = 'block';
            correctSelect.innerHTML = '<option value="A">A</option><option value="B">B</option><option value="C">C</option><option value="D">D</option>';
        }
    }
</script>
