@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var sections = (List<CBAssessment.Models.Section>)ViewBag.Sections;
}

<div class="auth-container">
    <div class="auth-card">
        <h1>Register</h1>
        <p class="subtitle">Create your account</p>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-error">@ViewBag.Error</div>
        }

        <form asp-action="Register" method="post">
            <div class="form-group">
                <label>Full Name</label>
                <input type="text" name="fullName" required placeholder="Enter full name" />
            </div>
            <div class="form-group">
                <label>Username</label>
                <input type="text" name="username" required placeholder="Choose a username" />
            </div>
            <div class="form-group">
                <label>Password</label>
                <input type="password" name="password" required minlength="6" placeholder="Min 6 characters" />
            </div>
            <div class="form-group">
                <label>Confirm Password</label>
                <input type="password" name="confirmPassword" required placeholder="Confirm password" />
            </div>
            <div class="form-group">
                <label>Role</label>
                <select name="role" id="roleSelect" onchange="toggleClassSection()">
                    <option value="Student">Student</option>
                    <option value="Teacher">Teacher</option>
                </select>
            </div>
            <div class="form-group" id="classSectionGroup">
                <label>Section</label>
                <select name="classSection" id="classSectionSelect">
                    <option value="">-- Select Section --</option>
                    @if (sections.Any())
                    {
                        @foreach (var sec in sections)
                        {
                            <option value="@sec.Name">@sec.Name</option>
                        }
                    }
                </select>
                @if (!sections.Any())
                {
                    <small class="text-muted">No sections available. Contact your teacher.</small>
                }
            </div>
            <button type="submit" class="btn btn-primary btn-block">Register</button>
        </form>

        <p class="auth-link">Already have an account? <a asp-action="Login">Login here</a></p>
    </div>
</div>

<script>
    function toggleClassSection() {
        var role = document.getElementById('roleSelect').value;
        document.getElementById('classSectionGroup').style.display = role === 'Student' ? 'block' : 'none';
    }
</script>
