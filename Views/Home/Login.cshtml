@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="auth-container">
    <div class="auth-card">
        <h1>CB Assessment</h1>
        <p class="subtitle">Computer-Based Assessment System</p>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-error">@ViewBag.Error</div>
        }
        @if (ViewBag.Success != null)
        {
            <div class="alert alert-success">@ViewBag.Success</div>
        }

        <form asp-action="Login" method="post">
            <div class="form-group">
                <label>Username</label>
                <input type="text" name="username" required placeholder="Enter username" />
            </div>
            <div class="form-group">
                <label>Password</label>
                <input type="password" name="password" required placeholder="Enter password" />
            </div>
            <button type="submit" class="btn btn-primary btn-block">Login</button>
        </form>

        <p class="auth-link">Don't have an account? <a asp-action="Register">Register here</a></p>

        <div class="demo-accounts">
            <h3>Demo Accounts</h3>
            <div class="demo-grid">
                <div class="demo-item">
                    <strong>Teacher:</strong>
                    <span>teacher / teacher123</span>
                </div>
                <div class="demo-item">
                    <strong>Student:</strong>
                    <span>john / student123</span>
                </div>
            </div>
        </div>
    </div>
</div>
