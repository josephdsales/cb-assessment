@model CBAssessment.Models.ExamResult
@{
    ViewData["Title"] = "Exam Result";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var percentage = (double)ViewBag.Percentage;
    var studentAnswers = (List<CBAssessment.Models.StudentAnswer>)ViewBag.StudentAnswers;
    var hasPending = (bool)ViewBag.HasPendingReview;
}

<div class="page-header">
    <h1>Exam Result</h1>
    <a asp-action="Dashboard" class="btn btn-secondary">Back to Dashboard</a>
</div>

@if (hasPending)
{
    <div class="alert alert-success">
        Some questions require manual grading by your teacher. Your score may change after review.
    </div>
}

<div class="result-container">
    <div class="result-card">
        <h2>@Model.Exam?.Title</h2>
        <p class="result-subject">@(Model.Exam?.Subject?.Name ?? "N/A")</p>

        <div class="score-circle @(percentage >= 70 ? "score-pass" : "score-fail")">
            <span class="score-percentage">@percentage.ToString("F1")%</span>
            <span class="score-fraction">@Model.Score / @Model.TotalPoints</span>
        </div>

        <div class="result-details">
            <div class="detail-item">
                <strong>Correct Answers:</strong>
                <span>@Model.CorrectAnswers / @Model.TotalQuestions</span>
            </div>
            <div class="detail-item">
                <strong>Submitted:</strong>
                <span>@Model.SubmittedAt.ToString("MMM dd, yyyy HH:mm")</span>
            </div>
            <div class="detail-item">
                <strong>Status:</strong>
                @if (hasPending)
                {
                    <span class="score-badge" style="background:#fef3c7;color:#d97706;">PENDING REVIEW</span>
                }
                else
                {
                    <span class="score-badge @(percentage >= 70 ? "score-pass" : "score-fail")">
                        @(percentage >= 70 ? "PASSED" : "FAILED")
                    </span>
                }
            </div>
        </div>
    </div>

    <h2>Question Review</h2>
    @{ int qIdx = 1; }
    @foreach (var sa in studentAnswers)
    {
        var q = sa.Question;
        <div class="question-card review-question @(sa.IsPendingReview ? "pending" : (sa.IsCorrect ? "correct" : "incorrect"))">
            <div class="question-header">
                <span class="q-number">Q@(qIdx++)</span>
                @if (sa.IsPendingReview)
                {
                    <span class="result-icon pending-icon">⏳</span>
                }
                else if (sa.IsCorrect)
                {
                    <span class="result-icon" style="color:var(--success)">&#10003;</span>
                }
                else
                {
                    <span class="result-icon" style="color:var(--danger)">&#10007;</span>
                }
            </div>
            <p class="question-text">@q?.Text</p>

            @if (q?.Type == CBAssessment.Models.QuestionType.MultipleChoice)
            {
                <div class="options-display">
                    <div class="option @(sa.SelectedAnswer == "A" ? "selected" : "") @(q.CorrectAnswer == "A" ? "correct-opt" : "")">A. @q.OptionA</div>
                    <div class="option @(sa.SelectedAnswer == "B" ? "selected" : "") @(q.CorrectAnswer == "B" ? "correct-opt" : "")">B. @q.OptionB</div>
                    @if (q.OptionC != null)
                    {
                        <div class="option @(sa.SelectedAnswer == "C" ? "selected" : "") @(q.CorrectAnswer == "C" ? "correct-opt" : "")">C. @q.OptionC</div>
                    }
                    @if (q.OptionD != null)
                    {
                        <div class="option @(sa.SelectedAnswer == "D" ? "selected" : "") @(q.CorrectAnswer == "D" ? "correct-opt" : "")">D. @q.OptionD</div>
                    }
                </div>
            }
            else if (q?.Type == CBAssessment.Models.QuestionType.TrueFalse)
            {
                <div class="options-display">
                    <div class="option @(sa.SelectedAnswer == "A" ? "selected" : "") @(q.CorrectAnswer == "A" ? "correct-opt" : "")">True</div>
                    <div class="option @(sa.SelectedAnswer == "B" ? "selected" : "") @(q.CorrectAnswer == "B" ? "correct-opt" : "")">False</div>
                </div>
            }
            else if (q?.Type == CBAssessment.Models.QuestionType.FillInBlank)
            {
                <div class="answer-info">
                    Your answer: <strong>@(string.IsNullOrEmpty(sa.SelectedAnswer) ? "No answer" : sa.SelectedAnswer)</strong>
                </div>
            }
            else if (q?.Type == CBAssessment.Models.QuestionType.LongAnswer)
            {
                <div class="long-answer-review">
                    <strong>Your Answer:</strong>
                    <div class="long-answer-text">@(sa.LongAnswerText ?? "No answer provided")</div>
                    @if (q.SampleAnswer != null)
                    {
                        <div class="sample-answer">
                            <strong>Sample Answer:</strong>
                            <div>@q.SampleAnswer</div>
                        </div>
                    }
                    @if (sa.IsPendingReview)
                    {
                        <span class="score-badge" style="background:#fef3c7;color:#d97706;">Awaiting teacher review</span>
                    }
                    else
                    {
                        <span>Points awarded: <strong>@(sa.AwardedPoints ?? 0) / @q.Points</strong></span>
                    }
                </div>
            }
            else if (q?.Type == CBAssessment.Models.QuestionType.MatchingType)
            {
                <div class="answer-info">
                    Your matching: <strong>@(string.IsNullOrEmpty(sa.SelectedAnswer) ? "No answer" : sa.SelectedAnswer)</strong> |
                    Correct: <strong>@q.CorrectAnswer</strong>
                </div>
            }
            else if (q?.Type == CBAssessment.Models.QuestionType.Ordering)
            {
                <div class="answer-info">
                    Your order: <strong>@(string.IsNullOrEmpty(sa.SelectedAnswer) ? "No answer" : sa.SelectedAnswer)</strong> |
                    Correct: <strong>@q.CorrectAnswer</strong>
                </div>
            }

            <div class="answer-info">
                @if (!sa.IsPendingReview)
                {
                    <span>Points: <strong>@(sa.IsCorrect ? q?.Points : 0) / @q?.Points</strong></span>
                }
            </div>
        </div>
    }
</div>
